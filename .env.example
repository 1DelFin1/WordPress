# PostgreSQL
POSTGRES_DB=inpad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# JWT — используйте длинную случайную строку в продакшене
JWT_SECRET=change-me-to-a-random-32-char-secret
JWT_ISSUER=inpad-api
JWT_AUDIENCE=inpad-frontend
JWT_EXPIRY_MINUTES=1440

# Seed — первый администратор (создаётся при первом запуске)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password

# WordPress (оставьте пустыми чтобы отключить интеграцию)
WORDPRESS_URL=https://inpad.ru
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_POST_TYPE=objects